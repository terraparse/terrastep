{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/check_claude_md_hook.sh",
            "statusMessage": "Checking CLAUDE.md for a dated section heading..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/check_status_stop_hook.sh",
            "statusMessage": "Checking journal status format..."
          }
        ]
      }
    ]
  }
}
